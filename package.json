{
  "name": "slsu-gc-research-repository",
  "version": "1.0.0",
  "description": "SLSU-GC Research Paper Repository and Digital Archiving System",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "dev": "concurrently -n backend,frontend -c blue,green \"nodemon backend/app.js\" \"cd slsu-research-repository/frontend && npx vite\"",
    "dev:backend": "nodemon backend/app.js",
    "dev:frontend": "cd slsu-research-repository/frontend && npx vite",
    "build": "cd slsu-research-repository/frontend && npm run build",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.4",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "slsu",
    "research",
    "repository",
    "digital-archive",
    "academic"
  ],
  "license": "MIT"
}
