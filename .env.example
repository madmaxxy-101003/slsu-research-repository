# ============================================================
# SLSU-GC Research Repository - Environment Configuration
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=slsu_research_repository

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_this
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_TIMEOUT=3600

# File Upload
MAX_FILE_SIZE=52428800

# Frontend origin (used to redirect the browser back after Google OAuth)
FRONTEND_URL=http://localhost:5173

# Google OAuth (Continue with Google)
# Create credentials at https://console.cloud.google.com/ -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ============================================================
# Supabase (Production Backend)
# ============================================================
# Find these in the Supabase Dashboard -> Project Settings -> API.
#   - SUPABASE_URL is the "Project URL".
#   - SUPABASE_PUBLISHABLE_KEY (anon key) is the "Publishable / anon" key.
#   - SUPABASE_SERVICE_ROLE_KEY is the "service_role" key.
#
# SECURITY: The service-role key BYPASSES Row Level Security and must
# NEVER be placed in frontend code or committed to GitHub. It lives ONLY
# here (backend .env) / in the backend host's environment. The publishable
# (anon) key may be used in frontend code.
SUPABASE_URL=https://nrqjvntugmblmcmulrkx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
